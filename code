class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int n = matrix.length;
        int m = matrix[0].length;
        int l=0,r=n*m-1;
        while(l<=r){
            int mid=l+(r-l)/2;
            int row=mid/m;
            int col=mid%m;
            if(matrix[row][col]==target){
                return true;
            }
            else if(matrix[row][col]>target){
                r=mid-1;
            }
            else l=mid+1;
        }
        return false;
    }
}

class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int l=1,r=0;
        for(int p:piles){
            r=Math.max(r,p);
        }
        int ans=r;
        while(l<=r){
            int mid=l+(r-l)/2;
            if(caneat(piles,mid,h)){
                ans=mid;
                r=mid-1;
            }
            else l= mid+1;
        }
        return ans;
    }
    public boolean caneat(int []piles,int mid ,int h){
        long cnt=0;
        for(int x:piles){
            if(x%mid==0)cnt+=x/mid;
            else cnt+= x/mid +1;
        }
        return (h>=cnt);
    }
}

class Solution {
    public int shipWithinDays(int[] weights, int days) {
        int l=1,r=0;
        for(int w:weights){
            r+=w;
            l=Math.max(w,l);
        }
        int ans =r;
        while(l<=r){
        int mid=l+(r-l)/2;
        if(canship(weights,mid,days)){
            ans=mid;
            r=mid-1;
        }
        else l=mid+1;
        }
        return ans;
    }
    public boolean canship(int []nums,int mid, int d){
        int cnt=1;
        int wt=0;
        for(int x:nums){
            if(wt + x > mid){
                cnt++;
                wt=x;
            }
            else{
                wt+=x;
            }
        }
        return( cnt <= d);
    }
}

class Solution {
    public int findMin(int[] nums) {
        int i=0,j=nums.length-1;
        while(i<j){
            int mid=i+(j-i)/2;
            if(nums[mid]<nums[j]){
                j=mid;
            }
            else i=mid+1;
        }
        return nums[i];
    }
}
class Solution {
    public int search(int[] nums, int target) {
      int l=0,h=nums.length-1;
      while(l<=h){
        int mid=l+(h-l)/2;
        //left sorted 
        if(nums[mid] == target) return mid;
        if(nums[l]<=nums[mid]){
            if(target>=nums[l] && target<nums[mid]){
                h=mid-1;
            }
            else l=mid+1;
        }
        // rightsorted
        else{
            if(target<=nums[h] && target>nums[mid]){
                l=mid+1;

            }else{
                h=mid-1;
            }
        }
      }  
      return -1;
    }
}






















