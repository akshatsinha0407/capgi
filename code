class Solution {
    public void reverseString(char[] s) {
        int n =s.length;
        if(n<=1)return ;
        int i=0,j=n-1;
        while(i<=j){
            char temp=s[i];
            s[i]=s[j];
            s[j]=temp;
            i++;
            j--;
        }
        return;
    }
}
class Solution {
    public boolean isPalindrome(String s) {
        int l=0;
        int r=s.length()-1;
        while(l<r){
            while(l<r && !Character.isLetterOrDigit(s.charAt(l) ) )l++;
            while(l<r && !Character.isLetterOrDigit(s.charAt(r))) r--;
            if(Character.toLowerCase(s.charAt(l)) != Character.toLowerCase(s.charAt(r)))return false;
            l++;
            r--;
        }
        return true;
    }
}
class Solution {
    public boolean validPalindrome(String s) {
        int i=0;
        int j=s.length()-1;
        while(i<j){
            if(s.charAt(i)!=s.charAt(j)){
                boolean l =pal(s,i+1,j);
                boolean r =pal(s,i,j-1);
                return l || r;
            }
            i++;
            j--;
        }
        return true;
    }
    public boolean pal(String s, int i, int j){
        while(i<j ){
            if(s.charAt(i)!=s.charAt(j))return false;
            i++;
            j--;
        }
        return true;
    }
}

class Solution {
    public String mergeAlternately(String word1, String word2) {
        int n=word1.length(),m=word2.length();
        int i=0,j=0;
        StringBuilder sb = new StringBuilder();
        while(i<n && j<m){
            if(i==j){sb.append(word1.charAt(i));i++;}
            else if(i>j) {sb.append(word2.charAt(j));j++;}
        }
        while(i<n){sb.append(word1.charAt(i));i++;}
        while(j<m){sb.append(word2.charAt(j));j++;}
        return sb.toString();

    }
}

class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int i = m - 1;
        int j = n - 1;
        int k = m + n - 1;

        while (j >= 0) {
            if (i >= 0 && nums1[i] > nums2[j]) {
                nums1[k] = nums1[i];
                i--;
            } else {
                nums1[k] = nums2[j];
                j--;
            }
            k--;
        }
    }
}
