class Solution {
    public int trap(int[] height) {
        int ans=0;
        int l=0,r=height.length-1;
        int lmax=0,rmax=0;
        while(l<r){
            if(height[l]<=height[r]){
                if(height[l]>lmax){
                    lmax=height[l];
                }
                else{
                    ans+=height[l]-lmax;
                }
                l++;
            }
            else if(height[l]>=height[r]){
                if(height[r]>rmax){
                    rmax=height[r];
                }
                else{
                    ans+=height[r]-rmax;
                }
                r--;
            }
        }
        return -ans;
    }
}


