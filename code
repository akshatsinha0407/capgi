// Array hashing
class Solution {
    public int[] getConcatenation(int[] nums) {
        int n = nums.length;
        int ans [] = new int [2*n];
        for(int i=0;i<2*n;i++){
            
                ans[i]=nums[i%n];
            
        }
        return ans;
    }
}

class Solution {
    public boolean containsDuplicate(int[] nums) {
        Set<Integer> set = new HashSet<>();
        set.add(nums[0]);
        for(int i=1;i<nums.length;i++){
            if( set.contains( nums[i] ) )return true;
            else set.add(nums[i]);

        }
        return false;
    }
}

class Solution {
    public boolean isAnagram(String s, String t) {
        //base
        if(s.length()!=t.length())return false;
        int []fq= new int [26];
        int n =s.length();
        for(int i=0;i<n;i++){
            
            int a = s.charAt(i)-'a';
            int b= t.charAt(i)-'a';
            fq[a]++;
            fq[b]--;
        }
        for(int x: fq){
            if(x!=0)return false;
        }
        return true;
    }
}

class Solution {
    public int[] twoSum(int[] nums, int target) {
        // 2 7 11 15 tgt 9 
        Map<Integer,Integer>map= new HashMap<>();
        
        for(int i=0;i<nums.length;i++){
            int req = target -nums[i];
            if(map.containsKey(req)){
                return new int [] {map.get(req),i};
            }
            map.put(nums[i],i);
        }
        return new int []{-1,-1};
    }
}

class Solution {
    public String longestCommonPrefix(String[] strs) {
        if(strs.length==0)return "";
        String pr=strs[0];
        for(int i=1;i<strs.length;i++){
            while(!strs[i].startsWith(pr)){
                pr=pr.substring(0,pr.length()-1);
                if(pr.length()==0)return "";
            }
        }
        return pr;
    }

}

class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {
        Map<String ,List<String> > map = new HashMap<>();
        for(String s:strs){
            char [] carr =s.toCharArray();
            Arrays.sort(carr);
            String hui =  String.valueOf(carr);
            map.putIfAbsent(hui,new ArrayList<>());
            map.get(hui).add(s);
        }
        return new ArrayList<>(map.values());
    }
}

class Solution {
    public int removeElement(int[] nums, int val) {
        int n = nums.length;
        int cnt=0;
        
        for(int i=0;i<n;i++){
            if(nums[i]!=val){
                nums[cnt]=nums[i];
                cnt++;
            }
        }
        return cnt++;
    }
}

class Solution {
    public int majorityElement(int[] nums) {
        Map<Integer,Integer> map=new HashMap<>();
        for(int x:nums){
            map.put(x,map.getOrDefault(x,0)+1);
        }
        for(int x :map.keySet()){
            if(map.get(x)>nums.length/2)return x;
        }
        return -1;
    }
}

class Solution {
    public int[] sortArray(int[] nums) {
        mergesort(nums,0,nums.length-1);
        return nums;
    }
    public void mergesort(int[] nums,int st,int end){
        if(st>=end)return;
        int mid = st+(end-st)/2;
        mergesort(nums,st,mid);
        mergesort(nums,mid+1,end);
        merge(nums,st,mid,end);

    }
    public void merge(int []nums, int st, int mid, int end){
        int []temp= new int [end-st+1];
        int i=st;
        int j=mid+1;
        int k=0;
        while(i<=mid&&j<=end){
            if(nums[i]<=nums[j]){
                temp[k++]=nums[i++];
            }else temp[k++]=nums[j++];
        }
        while (i <= mid) {
            temp[k++] = nums[i++];
        }

        while (j <= end) {
            temp[k++] = nums[j++];
        }
        for(int x=0;x<temp.length;x++){
            nums[st+x]=temp[x];
        }

    }
}

class Solution {
    public void sortColors(int[] nums) {
        int st=0,mid=0,end=nums.length-1;
        while(mid<=end){
            if(nums[mid]==0){
                swap(nums,st,mid);
                st++;
                mid++;
            }
            else if(nums[mid]==1)mid++;
            else{
                swap(nums,mid,end);
                end--;
            }
        }
        return;
    }
    public void swap(int []nums,int st,int end){
        int temp =nums[st];
        nums[st]=nums[end];
        nums[end]=temp;
        return;
    }
}


class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        Map<Integer, Integer> map = new HashMap<>();
        for (int x : nums)
            map.put(x, map.getOrDefault(x, 0) + 1);
        PriorityQueue<Integer> pq = new PriorityQueue<>((a, b) -> map.get(a) - map.get(b));
        for (int x : map.keySet()) {
            pq.offer(x);
            if (pq.size() > k)
                pq.poll();
        }
        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {
            ans[i] = pq.poll();
        }
        return ans;
    }
}

class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n = nums.length;
        int [] larr =new int [n];
        int[] rarr= new int [n];
        larr[0]=nums[0];
        rarr[n-1]=nums[n-1];
        for(int i=1;i<n;i++){
            larr[i]=nums[i]*larr[i-1];
            rarr[n-i-1]=nums[n-i-1]*rarr[n-i];
        }
        int ans[] =new int [n];
        for(int i=0;i<n;i++){
            if(i==0){
                ans[i]=rarr[i+1];
            }
            else if (i==n-1){
                ans[i]=larr[i-1];
            }
            else ans[i]=larr[i-1]*rarr[i+1];
        }
        return ans;
    }
}

class Solution {
    public boolean isValidSudoku(char[][] board) {
       int [][] row = new int [9][9];
       int [][] col = new int [9][9];
       int [][] box = new int [9][9];
       for(int i =0;i<9;i++){
        for(int j=0;j<9;j++){
            if(board[i][j]=='.')continue;
            int val = board[i][j]-'1';
            if(row[i][val]==1)return false;
            row[i][val]=1;
            if(col[j][val]==1)return false;
            col[j][val]=1;
            int bid = 3*(i/3)+j/3;
            if(box[bid][val]==1)return false;
            box[bid][val]=1;
        }
       } 
       return true;
    }
}

class Solution {
    public int longestConsecutive(int[] nums) {
       Map<Integer ,Boolean> map =new HashMap<>();
       if(nums.length==0)return 0;
       for(int x:nums){
        map.put(x,false);
       }
       int ans=1;
       for(int num :nums){
        int len=1;
        int next=num+1;
        while(map.containsKey(next)&&map.get(next)==false){
            len++;
            map.put(next,true);
            next++;
        }
        int prev=num-1;
        while(map.containsKey(prev)&&map.get(prev)==false){
            len++;
            map.put(prev,true);
            prev--;
        }
        ans=Math.max(ans,len);
       }
        return ans;
    }
}

class Solution {
    public int maxProfit(int[] prices) {
        int pro=0;
        for(int i=1;i<prices.length;i++){
           if(prices[i-1]<prices[i])pro+=prices[i]-prices[i-1]; 
        }
        return pro;
    }
}

class Solution {
    public List<Integer> majorityElement(int[] nums) {
        List<Integer> list = new ArrayList<>();
        Map<Integer,Integer> map = new HashMap<>();
        for(int x:nums){
            map.put(x,map.getOrDefault(x,0)+1);
        }
        for(int y :map.keySet()){
            if(map.get(y)>nums.length/3)list.add(y);
        }
        return list;
    }
}

class Solution {
    public int subarraySum(int[] nums, int k) {
        int cnt=0;
        Map<Integer,Integer>map = new HashMap<>();
        map.put(0,1);
        int pre=0;
        for(int i=0;i<nums.length;i++){
            pre+=nums[i];
            if(map.containsKey(pre-k)){
                cnt+=map.get(pre-k);
            }
            map.put(pre,map.getOrDefault(pre,0)+1);
        }
        return cnt;
    }
}

class Solution {
    public int firstMissingPositive(int[] nums) {
        Arrays.sort(nums);
        int ans=1;
        for(int x:nums){
            if(x<=0)continue;
            else if(x>ans)return ans;
            else if(ans==x)ans++;
        }
        return ans;
    }
}
